# Copy to .env.local and fill in.
#
# Local development: run `pnpm db:start`, then `pnpm exec supabase status -o env`
# and use API_URL, PUBLISHABLE_KEY and SECRET_KEY.
#
# Production: Supabase dashboard -> Project Settings -> API Keys.
# Set the first two in the Vercel project's Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only used by the command-line scripts (create-user, seed:demo). Never expose it,
# and it does not need to be set on Vercel.
SUPABASE_SECRET_KEY=
